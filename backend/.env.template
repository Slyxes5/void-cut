# VOID CUT — Environment Template
# ============================================================
# This app can run locally or deployed to a server.
# API keys for Gemini can be provided by users at runtime via the web interface.
#
# Get a free Gemini API key at: https://aistudio.google.com/
# ============================================================

# ── Gemini API (Optional Server Default) ──────────────────────
# If not set here, users must provide it in the web interface.
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Mandatory Single-User Login ──────────────────────────────
# Run locally: venv\Scripts\python.exe -m backend.setup_login --origin https://YOUR-PRIVATE-HOST
# The helper writes a salted scrypt hash, not a plaintext password. Never commit backend/.env.
# CHEAT_CLIP_PASSWORD_HASH=generated_by_setup_login
# CHEAT_CLIP_ALLOWED_ORIGINS=https://YOUR-PRIVATE-HOST
# Optional machine-to-machine administrator token. Missing tokens NEVER grant access.
# ADMIN_API_KEY=configure_only_if_needed

# ── Supadata API Keys (Tier 1 Fallback) ────────────────────────
# Supadata provides cloud-hosted residential IP proxying for YouTube transcripts.
# Multiple keys can be comma-separated or space-separated for automatic round-robin rotation.
# Get free keys (100 credits/mo each) at: https://supadata.ai/
# SUPADATA_API_KEYS=sd_key1,sd_key2,sd_key3

# ── Webshare Rotating Proxy (Tier 2-4 Fallback) ───────────────
# Per https://github.com/jdepoix/youtube-transcript-api#working-around-ip-bans-requestblocked-or-ipblocked-exception
# Webshare rotating proxies prevent YouTube datacenter IP bans (IpBlocked/RequestBlocked).
# Register at: https://www.webshare.io/
# WEBSHARE_USERNAME=your_username
# WEBSHARE_PASSWORD=your_password
# WEBSHARE_LOCATIONS=US,GB,DE
# WEBSHARE_RETRIES=5

# Alternatively, define the full Webshare proxy URL or generic proxy:
# WEBSHARE_PROXY=http://username-rotate:password@p.webshare.io:80
# PROXY_URL=http://username:password@proxy_host:port

# ── Custom SSL Certificate Bundle (Optional) ─────────────────
# Path to custom CA bundle if running behind an SSL-inspecting proxy
# REQUESTS_CA_BUNDLE=/path/to/cacert.pem

# ── Color Emoji Font Path (Optional) ─────────────────────────
# Path to a color emoji font (.ttf / .otf) such as NotoColorEmoji.ttf or seguiemj.ttf
# If not specified, Void Cut automatically uses backend/fonts/seguiemj.ttf or system fonts.
# EMOJI_FONT_PATH=/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf

# Whisper speech recognition model. Default: base. Set small for a larger model
# if your machine has enough memory; the first use downloads the selected model.
# WHISPER_MODEL=base

# Social uploads: run python backend/setup_social_uploads.py to create the
# encryption key in backend/.env. Never put secrets in frontend VITE_* settings.
# SOCIAL_TOKEN_ENCRYPTION_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:5173/social/oauth/youtube/callback
# TIKTOK_CLIENT_ID=  # TikTok calls this value Client Key.
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://your-app.example/social/oauth/tiktok/callback
# Direct Post is optional and requires video.publish + an eligible API app.
# Keep disabled for the initial draft/inbox integration.
# TIKTOK_DIRECT_POST_ENABLED=false
# TIKTOK_DIRECT_POST_AUDITED=false

